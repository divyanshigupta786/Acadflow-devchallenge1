# Database (PostgreSQL with pgvector for production/docker, or SQLite for instant local runs)
DATABASE_URL=sqlite:///./acadflow.db
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/acadflow

# Security & Auth
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Open-Source LLM Provider
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-small-en-v1.5

# Storage
STORAGE_PATH=./storage

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
